# Docker Compose. Copy to .env and replace before running. Never commit .env.
POSTGRES_DB=vgg
POSTGRES_USER=vgg
# Use a strong URL-safe password (or percent-encode it for DATABASE_URL).
POSTGRES_PASSWORD=REPLACE_WITH_RANDOM_SECRET
WEBSITE_HOST=website.example.org
CMS_HOST=cms.example.org
PUBLIC_APP_URL=https://website.example.org
CMS_APP_URL=https://cms.example.org
# Set false on test/staging; true only on the approved production domain.
SITE_INDEXABLE=false
TLS_DIRECTORY=/etc/vgg/tls
APP_IMAGE=vgg-app:local
TOOLS_IMAGE=vgg-tools:local
# Private Docker network; adjust all three together if this subnet conflicts.
VGG_APP_SUBNET=172.30.10.0/24
VGG_FRONTEND_IP=172.30.10.10
VGG_CMS_IP=172.30.10.11
# Existing MinIO data/credentials are retained. Set these before deployment.
STORAGE_BUCKET=vgg-media
MINIO_ROOT_USER=vgg_storage_root
MINIO_ROOT_PASSWORD=REPLACE_WITH_DIFFERENT_RANDOM_SECRET
MINIO_APP_ACCESS_KEY=vgg_media_reader
MINIO_APP_SECRET_KEY=REPLACE_WITH_APP_RANDOM_SECRET
