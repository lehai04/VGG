{
  "name": "@vgg/backend",
  "version": "1.0.2",
  "private": true,
  "type": "module",
  "scripts": {
    "dev": "prisma generate && tsx watch src/server.ts",
    "build": "prisma generate && tsc",
    "start": "node dist/server.js",
    "test": "npm run build && node --test tests/*.test.mjs",
    "typecheck": "prisma generate && tsc --noEmit",
    "prisma:generate": "prisma generate",
    "prisma:migrate": "prisma migrate dev",
    "prisma:deploy": "prisma migrate deploy",
    "prisma:push": "prisma db push",
    "db:seed": "tsx prisma/seed-public.ts",
    "seed-cms-admin": "node seed-cms-admin.mjs",
    "staff:manage": "node scripts/consultation-staff.mjs",
    "staff:seed": "node scripts/seed-cms-admin.mjs"
  },
  "dependencies": {
    "@aws-sdk/client-s3": "3.1159.0",
    "@fastify/cors": "^11.3.0",
    "@fastify/helmet": "^13.1.1",
    "@fastify/multipart": "10.1.6",
    "@fastify/rate-limit": "^11.2.0",
    "@prisma/adapter-pg": "^7.9.1",
    "@prisma/client": "^7.9.1",
    "dotenv": "^17.4.2",
    "fastify": "^5.12.1",
    "mammoth": "1.13.0",
    "pg": "^8.23.0",
    "sanitize-html": "2.18.1",
    "sharp": "0.35.5",
    "zod": "^4.4.3"
  },
  "devDependencies": {
    "@types/node": "^22.19.19",
    "@types/pg": "^8.23.1",
    "@types/sanitize-html": "2.16.2",
    "prisma": "^7.9.1",
    "tsx": "^4.23.12"
  }
}
