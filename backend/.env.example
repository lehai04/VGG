# Local development only. Docker uses root .env + compose.yaml instead.
# ==============================================================================
# Backend API Service Environment Configuration Template
# ==============================================================================
NODE_ENV=development
DATABASE_URL=postgresql://vgg:REPLACE_WITH_URL_ENCODED_PASSWORD@127.0.0.1:5432/vgg_public

BACKEND_HOST=127.0.0.1
BACKEND_PORT=4000
PUBLIC_APP_URL=http://localhost:3000

# Optional: only needed for existing objects served through /api/media/.
# Supplied images and PDFs are served by frontend/public without this service.
# STORAGE_ENDPOINT=127.0.0.1
# STORAGE_PORT=9000
# STORAGE_USE_SSL=false
# STORAGE_REGION=us-east-1
# STORAGE_BUCKET=vgg-media
# STORAGE_ACCESS_KEY=vgg_platform_app
# STORAGE_SECRET_KEY=REPLACE_WITH_STORAGE_PASSWORD

CMS_APP_URL=http://localhost:3001

