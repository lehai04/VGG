generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "postgresql"
}

enum ConsultationStatus {
  NEW
  RECEIVED
  CONTACTING
  CONSULTED
  COMPLETED
  UNREACHABLE
  CANCELLED
}

enum ContentStatus {
  DRAFT
  PUBLISHED
  ARCHIVED
}

enum ResourceType {
  DIRECTIVE_DOCUMENT
  EXECUTION_DOCUMENT
  BROCHURE
  PDF_DOCUMENT
}

enum ResourceDocumentType {
  REGULATION
  RULE
  PROCESS
  NOTICE
  GUIDELINE
}

model NewsPost {
  id          String        @id @default(cuid())
  slug        String        @unique @db.VarChar(190)
  locale      String        @default("vi") @db.VarChar(5)
  title       String        @db.VarChar(250)
  category    String        @default("GENERAL") @db.VarChar(50)
  excerpt     String?
  content     String
  coverImage  String?       @map("cover_image") @db.VarChar(1000)
  coverImageAlt String?     @map("cover_image_alt") @db.VarChar(500)
  metaTitle   String?       @map("meta_title") @db.VarChar(250)
  metaDescription String?   @map("meta_description") @db.VarChar(1000)
  canonicalUrl String?      @map("canonical_url") @db.VarChar(1000)
  robotsIndex Boolean       @default(true) @map("robots_index")
  robotsFollow Boolean      @default(true) @map("robots_follow")
  ogTitle     String?       @map("og_title") @db.VarChar(250)
  ogDescription String?     @map("og_description") @db.VarChar(1000)
  ogImage     String?       @map("og_image") @db.VarChar(1000)
  ogImageAlt  String?       @map("og_image_alt") @db.VarChar(500)
  customJsonLd Json?        @map("custom_json_ld")
  status      ContentStatus @default(DRAFT)
  publishedAt DateTime?     @map("published_at")
  authorName  String?       @map("author_name") @db.VarChar(120)
  createdAt   DateTime      @default(now()) @map("created_at")
  updatedAt   DateTime      @updatedAt @map("updated_at")

  @@index([status, publishedAt])
  @@index([category, status, publishedAt])
  @@map("news_posts")
}

model ResourceFile {
  id                   String                @id @default(cuid())
  slug                 String                @unique @db.VarChar(190)
  locale               String                @default("vi") @db.VarChar(5)
  title                String                @db.VarChar(250)
  description          String?
  categoryId           String                @map("category_id")
  category             ResourceCategory      @relation(fields: [categoryId], references: [id], onDelete: Restrict)
  resourceType         ResourceType           @map("resource_type")
  documentType         ResourceDocumentType?  @map("document_type")
  documentNumber       String?                @map("document_number") @db.VarChar(100)
  issueDate            DateTime?              @map("issue_date") @db.Date
  issuingOrganization  String?                @map("issuing_organization") @db.VarChar(250)
  fileUrl              String                 @map("file_url") @db.VarChar(1000)
  fileName             String                 @map("file_name") @db.VarChar(255)
  fileType             String                 @map("file_type") @db.VarChar(120)
  fileSize             Int                    @map("file_size")
  status               ContentStatus          @default(PUBLISHED)
  publishedAt          DateTime?               @map("published_at")
  createdAt            DateTime                @default(now()) @map("created_at")
  updatedAt            DateTime                @updatedAt @map("updated_at")

  @@index([status, publishedAt])
  @@index([categoryId, resourceType])
  @@map("resource_files")
}

model ResourceCategory {
  id        String         @id @default(cuid())
  name      String         @unique @db.VarChar(120)
  resources ResourceFile[]
  createdAt DateTime       @default(now()) @map("created_at")
  updatedAt DateTime       @updatedAt @map("updated_at")

  @@map("resource_categories")
}

model SiteContent {
  id        String   @id @default(cuid())
  key       String   @unique @db.VarChar(190)
  locale    String   @default("vi") @db.VarChar(5)
  section   String   @db.VarChar(100)
  page      String   @db.VarChar(190)
  title     String?  @db.VarChar(250)
  value     Json
  published Boolean  @default(false)
  createdAt DateTime @default(now()) @map("created_at")
  updatedAt DateTime @updatedAt @map("updated_at")

  @@index([section, page, locale])
  @@map("site_contents")
}

model PageVisit {
  id        String   @id @default(cuid())
  path      String   @db.VarChar(500)
  locale    String?  @db.VarChar(5)
  visitorId String?  @map("visitor_id") @db.VarChar(100)
  createdAt DateTime @default(now()) @map("created_at")

  @@index([createdAt])
  @@index([path, createdAt])
  @@map("page_visits")
}

model Consultation {
  id                 String                @id @default(cuid())
  fullName           String                @map("full_name") @db.VarChar(120)
  email              String                @db.VarChar(190)
  phone              String                @db.VarChar(30)
  programme          String?               @db.VarChar(190)
  interestedField    String?               @map("interested_field") @db.VarChar(190)
  preferredDate      DateTime?             @map("preferred_date") @db.Date
  preferredTime      String?               @map("preferred_time") @db.VarChar(50)
  consultationMethod String?               @map("consultation_method") @db.VarChar(50)
  message            String?
  sourcePage         String?               @map("source_page") @db.VarChar(500)
  sourceComponent    String?               @map("source_component") @db.VarChar(120)
  status             ConsultationStatus    @default(NEW)
  history            ConsultationHistory[]
  createdAt          DateTime              @default(now()) @map("created_at")
  updatedAt          DateTime              @updatedAt @map("updated_at")

  @@index([status, createdAt])
  @@map("consultations")
}

model ConsultationHistory {
  id             String              @id @default(cuid())
  consultationId String              @map("consultation_id")
  consultation   Consultation        @relation(fields: [consultationId], references: [id], onDelete: Cascade)
  action         String              @db.VarChar(100)
  oldStatus      ConsultationStatus? @map("old_status")
  newStatus      ConsultationStatus? @map("new_status")
  metadata       Json?
  createdAt      DateTime            @default(now()) @map("created_at")

  @@index([consultationId, createdAt])
  @@map("consultation_history")
}
