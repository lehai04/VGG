generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "postgresql"
}

enum AdminStatus {
  ACTIVE
  INACTIVE
  LOCKED
}

enum ConsultationStatus {
  NEW
  RECEIVED
  CONTACTING
  CONSULTED
  COMPLETED
  UNREACHABLE
  CANCELLED
}

enum AuditAction {
  LOGIN_SUCCESS
  LOGIN_FAILED
  LOGOUT
  PASSWORD_CHANGED
  PASSWORD_RESET
  ACCOUNT_CREATED
  ACCOUNT_UPDATED
  ACCOUNT_DISABLED
  ACCOUNT_ENABLED
  ROLE_CHANGED
  PERMISSION_CHANGED
  CONSULTATION_CREATED
  CONSULTATION_UPDATED
  CONSULTATION_ASSIGNED
  CONSULTATION_NOTE_ADDED
}

enum ContentStatus {
  DRAFT
  PUBLISHED
  ARCHIVED
}

model Admin {
  id                  String                @id @default(cuid())
  username            String                @unique @db.VarChar(50)
  passwordHash        String                @map("password_hash")
  fullName            String                @map("full_name") @db.VarChar(120)
  email               String?               @db.VarChar(190)
  phone               String?               @db.VarChar(30)
  roleId              String                @map("role_id")
  role                Role                  @relation(fields: [roleId], references: [id])
  status              AdminStatus           @default(ACTIVE)
  mustChangePassword  Boolean               @default(true) @map("must_change_password")
  failedLoginAttempts Int                   @default(0) @map("failed_login_attempts")
  lockedUntil         DateTime?             @map("locked_until")
  lastLoginAt         DateTime?             @map("last_login_at")
  passwordChangedAt   DateTime?             @map("password_changed_at")
  createdById         String?               @map("created_by")
  createdBy           Admin?                @relation("AdminCreator", fields: [createdById], references: [id], onDelete: SetNull)
  createdAdmins       Admin[]               @relation("AdminCreator")
  sessions            Session[]
  auditLogs           AuditLog[]            @relation("AuditActor")
  targetAuditLogs     AuditLog[]            @relation("AuditTarget")
  consultations       Consultation[]        @relation("ConsultationAssignee")
  consultationNotes   ConsultationNote[]
  consultationHistory ConsultationHistory[]
  createdAt           DateTime              @default(now()) @map("created_at")
  updatedAt           DateTime              @updatedAt @map("updated_at")
  newsPosts           NewsPost[]
  resourceFiles       ResourceFile[]
  siteContents        SiteContent[]

  @@index([roleId])
  @@index([status])
  @@map("admins")
}

model NewsPost {
  id          String        @id @default(cuid())
  slug        String        @unique @db.VarChar(190)
  locale      String        @default("vi") @db.VarChar(5)
  title       String        @db.VarChar(250)
  category    String        @default("GENERAL") @db.VarChar(50)
  excerpt     String?
  content     String
  coverImage  String?       @map("cover_image") @db.VarChar(1000)
  status      ContentStatus @default(DRAFT)
  publishedAt DateTime?     @map("published_at")
  authorId    String        @map("author_id")
  author      Admin         @relation(fields: [authorId], references: [id])
  createdAt   DateTime      @default(now()) @map("created_at")
  updatedAt   DateTime      @updatedAt @map("updated_at")

  @@index([status, publishedAt])
  @@index([category, status, publishedAt])
  @@map("news_posts")
}

model ResourceFile {
  id          String        @id @default(cuid())
  slug        String        @unique @db.VarChar(190)
  locale      String        @default("vi") @db.VarChar(5)
  title       String        @db.VarChar(250)
  description String?
  category    String?       @db.VarChar(120)
  fileUrl     String        @map("file_url") @db.VarChar(1000)
  fileName    String?       @map("file_name") @db.VarChar(255)
  status      ContentStatus @default(DRAFT)
  publishedAt DateTime?     @map("published_at")
  authorId    String        @map("author_id")
  author      Admin         @relation(fields: [authorId], references: [id])
  createdAt   DateTime      @default(now()) @map("created_at")
  updatedAt   DateTime      @updatedAt @map("updated_at")

  @@index([status, publishedAt])
  @@map("resource_files")
}

model SiteContent {
  id        String   @id @default(cuid())
  key       String   @unique @db.VarChar(190)
  locale    String   @default("vi") @db.VarChar(5)
  section   String   @db.VarChar(100)
  page      String   @db.VarChar(190)
  title     String?  @db.VarChar(250)
  value     Json
  published Boolean  @default(false)
  authorId  String   @map("author_id")
  author    Admin    @relation(fields: [authorId], references: [id])
  createdAt DateTime @default(now()) @map("created_at")
  updatedAt DateTime @updatedAt @map("updated_at")

  @@index([section, page, locale])
  @@map("site_contents")
}

model PageVisit {
  id        String   @id @default(cuid())
  path      String   @db.VarChar(500)
  locale    String?  @db.VarChar(5)
  visitorId String?  @map("visitor_id") @db.VarChar(100)
  createdAt DateTime @default(now()) @map("created_at")

  @@index([createdAt])
  @@index([path, createdAt])
  @@map("page_visits")
}

model Application {
  id        String   @id @default(cuid())
  fullName  String   @map("full_name") @db.VarChar(120)
  email     String   @db.VarChar(190)
  phone     String   @db.VarChar(30)
  programme String?  @db.VarChar(190)
  status    String   @default("NEW") @db.VarChar(50)
  metadata  Json?
  createdAt DateTime @default(now()) @map("created_at")
  updatedAt DateTime @updatedAt @map("updated_at")

  @@index([status, createdAt])
  @@map("applications")
}

model Role {
  id          String           @id @default(cuid())
  code        String           @unique @db.VarChar(50)
  name        String           @db.VarChar(100)
  level       Int              @unique
  admins      Admin[]
  permissions RolePermission[]
  createdAt   DateTime         @default(now()) @map("created_at")
  updatedAt   DateTime         @updatedAt @map("updated_at")

  @@map("roles")
}

model Permission {
  id          String           @id @default(cuid())
  code        String           @unique @db.VarChar(100)
  description String?          @db.VarChar(255)
  roles       RolePermission[]
  createdAt   DateTime         @default(now()) @map("created_at")

  @@map("permissions")
}

model RolePermission {
  roleId       String     @map("role_id")
  permissionId String     @map("permission_id")
  role         Role       @relation(fields: [roleId], references: [id], onDelete: Cascade)
  permission   Permission @relation(fields: [permissionId], references: [id], onDelete: Cascade)

  @@id([roleId, permissionId])
  @@map("role_permissions")
}

model Session {
  id         String   @id @default(cuid())
  tokenHash  String   @unique @map("token_hash") @db.Char(64)
  adminId    String   @map("admin_id")
  admin      Admin    @relation(fields: [adminId], references: [id], onDelete: Cascade)
  expiresAt  DateTime @map("expires_at")
  createdAt  DateTime @default(now()) @map("created_at")
  lastSeenAt DateTime @default(now()) @map("last_seen_at")
  ipAddress  String?  @map("ip_address") @db.VarChar(64)
  userAgent  String?  @map("user_agent") @db.VarChar(500)

  @@index([adminId])
  @@index([expiresAt])
  @@map("admin_sessions")
}

model Consultation {
  id                 String                @id @default(cuid())
  fullName           String                @map("full_name") @db.VarChar(120)
  email              String                @db.VarChar(190)
  phone              String                @db.VarChar(30)
  programme          String?               @db.VarChar(190)
  interestedField    String?               @map("interested_field") @db.VarChar(190)
  preferredDate      DateTime?             @map("preferred_date") @db.Date
  preferredTime      String?               @map("preferred_time") @db.VarChar(50)
  consultationMethod String?               @map("consultation_method") @db.VarChar(50)
  message            String?
  sourcePage         String?               @map("source_page") @db.VarChar(500)
  sourceComponent    String?               @map("source_component") @db.VarChar(120)
  status             ConsultationStatus    @default(NEW)
  assignedAdminId    String?               @map("assigned_admin_id")
  assignedAdmin      Admin?                @relation("ConsultationAssignee", fields: [assignedAdminId], references: [id], onDelete: SetNull)
  notes              ConsultationNote[]
  history            ConsultationHistory[]
  createdAt          DateTime              @default(now()) @map("created_at")
  updatedAt          DateTime              @updatedAt @map("updated_at")

  @@index([status, createdAt])
  @@index([assignedAdminId])
  @@map("consultations")
}

model ConsultationNote {
  id             String       @id @default(cuid())
  consultationId String       @map("consultation_id")
  consultation   Consultation @relation(fields: [consultationId], references: [id], onDelete: Cascade)
  adminId        String       @map("admin_id")
  admin          Admin        @relation(fields: [adminId], references: [id])
  content        String
  createdAt      DateTime     @default(now()) @map("created_at")

  @@index([consultationId])
  @@map("consultation_notes")
}

model ConsultationHistory {
  id             String              @id @default(cuid())
  consultationId String              @map("consultation_id")
  consultation   Consultation        @relation(fields: [consultationId], references: [id], onDelete: Cascade)
  adminId        String?             @map("admin_id")
  admin          Admin?              @relation(fields: [adminId], references: [id], onDelete: SetNull)
  action         String              @db.VarChar(100)
  oldStatus      ConsultationStatus? @map("old_status")
  newStatus      ConsultationStatus? @map("new_status")
  metadata       Json?
  createdAt      DateTime            @default(now()) @map("created_at")

  @@index([consultationId, createdAt])
  @@map("consultation_history")
}

model AuditLog {
  id            String      @id @default(cuid())
  action        AuditAction
  actorAdminId  String?     @map("actor_admin_id")
  actor         Admin?      @relation("AuditActor", fields: [actorAdminId], references: [id], onDelete: SetNull)
  targetAdminId String?     @map("target_admin_id")
  target        Admin?      @relation("AuditTarget", fields: [targetAdminId], references: [id], onDelete: SetNull)
  targetType    String?     @map("target_type") @db.VarChar(100)
  targetId      String?     @map("target_id")
  username      String?     @db.VarChar(50)
  ipAddress     String?     @map("ip_address") @db.VarChar(64)
  userAgent     String?     @map("user_agent") @db.VarChar(500)
  metadata      Json?
  createdAt     DateTime    @default(now()) @map("created_at")

  @@index([actorAdminId])
  @@index([targetAdminId])
  @@index([action, createdAt])
  @@map("audit_logs")
}
