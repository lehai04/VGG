# Nginx is the only public entry point. The apps and database publish no ports.
limit_req_zone $binary_remote_addr zone=public_api:10m rate=5r/s;
limit_req_zone $binary_remote_addr zone=cms_login:10m rate=6r/m;
limit_req_status 429;
server_tokens off;
server { listen 80 default_server; server_name _; return 444; }
server {
  listen 80;
  server_name ${WEBSITE_HOST} ${CMS_HOST};
  return 308 https://$host$request_uri;
}
server {
  listen 443 ssl default_server;
  ssl_reject_handshake on;
}
server {
  listen 443 ssl;
  server_name ${WEBSITE_HOST};
  ssl_certificate /etc/nginx/tls/website/fullchain.pem;
  ssl_certificate_key /etc/nginx/tls/website/privkey.pem;
  ssl_protocols TLSv1.2 TLSv1.3;
  add_header Strict-Transport-Security "max-age=31536000" always;
  client_max_body_size 50m;
  client_body_timeout 10s;
  proxy_read_timeout 30s;
  proxy_set_header Host $host;
  proxy_set_header X-Forwarded-For $remote_addr;
  proxy_set_header X-Forwarded-Proto $scheme;
  proxy_http_version 1.1;
  location ~ (^|/)\. { return 404; }
  location ~* \.(sql|bak|env|pem|key|log|map)$ { return 404; }
  location ~ ^/(admin|cms|gateway|api/admin)(/|$) { return 404; }
  location /api/ { limit_req zone=public_api burst=20 nodelay; proxy_pass http://frontend:3000; }
  location / { proxy_pass http://frontend:3000; proxy_buffering off; }
}
server {
  listen 443 ssl;
  server_name ${CMS_HOST};
  ssl_certificate /etc/nginx/tls/cms/fullchain.pem;
  ssl_certificate_key /etc/nginx/tls/cms/privkey.pem;
  ssl_protocols TLSv1.2 TLSv1.3;
  add_header Strict-Transport-Security "max-age=31536000" always;
  add_header X-Robots-Tag "noindex, nofollow" always;
  client_max_body_size 50m;
  client_body_timeout 10s;
  proxy_read_timeout 30s;
  proxy_set_header Host $host;
  proxy_set_header X-Forwarded-For $remote_addr;
  proxy_set_header X-Forwarded-Proto $scheme;
  proxy_http_version 1.1;
  location ~ (^|/)\. { return 404; }
  location ~* \.(sql|bak|env|pem|key|log|map)$ { return 404; }
  location = /api/admin/login { client_max_body_size 16k; access_log off; limit_req zone=cms_login burst=5 nodelay; proxy_pass http://cms:3001; }
  location ~ ^/api/admin/(upload-image|upload-resource|import-word)$ { client_max_body_size 101m; client_body_timeout 120s; proxy_read_timeout 120s; access_log off; limit_req zone=public_api burst=5 nodelay; proxy_pass http://cms:3001; proxy_no_cache 1; proxy_cache_bypass 1; }
  location /api/ { access_log off; limit_req zone=public_api burst=20 nodelay; proxy_pass http://cms:3001; proxy_no_cache 1; proxy_cache_bypass 1; }
  location / { proxy_pass http://cms:3001; proxy_buffering off; }
}
