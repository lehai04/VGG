NODE_ENV=production
BACKEND_HOST=127.0.0.1
BACKEND_PORT=4000
DATABASE_URL=postgresql://REPLACE_USER:REPLACE_URL_ENCODED_PASSWORD@127.0.0.1:5432/REPLACE_DATABASE
PUBLIC_APP_URL=https://sdh.vlu.edu.vn
CMS_APP_URL=https://sdh.vlu.edu.vn/cms
# Required in BOTH backend.env and cms.env; missing this in backend causes
# "Nguồn yêu cầu không hợp lệ" before password verification.
# Preserve IT's existing DATABASE_URL and STORAGE_* settings.
# Uploads require a configured S3-compatible storage service.
# STORAGE_ENDPOINT=
# STORAGE_PORT=443
# STORAGE_USE_SSL=true
# STORAGE_REGION=us-east-1
# STORAGE_BUCKET=vgg-media
# STORAGE_ACCESS_KEY=
# STORAGE_SECRET_KEY=
