{
  "name": "vgg-platform",
  "version": "1.0.2",
  "private": true,
  "workspaces": [
    "frontend",
    "backend"
  ],
  "scripts": {
    "dev": "npm run dev --workspace=frontend",
    "dev:backend": "npm run dev --workspace=backend",
    "build": "npm run build --workspace=backend && npm run build --workspace=frontend",
    "start": "npm run start --workspace=frontend",
    "start:backend": "npm run start --workspace=backend",
    "db:deploy": "npm run prisma:deploy --workspace=backend",
    "db:seed": "npm run db:seed --workspace=backend",
    "test": "npm run test --workspace=backend && npm run test --workspace=frontend",
    "typecheck": "npm run typecheck --workspace=backend && npm run typecheck --workspace=frontend",
    "lint": "npm run lint --workspace=frontend"
  },
  "type": "module",
  "engines": {
    "node": "^26.12.1"
  },
  "allowScripts": {
    "argon2@0.45.1": true,
    "prisma@7.9.1": true,
    "@prisma/engines@7.9.1": true,
    "esbuild@0.28.2": true,
    "unrs-resolver@1.12.2": true
  }
}
