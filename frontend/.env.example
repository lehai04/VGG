# ==============================================================================
# Frontend Public Portal Environment Configuration Template
# ==============================================================================
NODE_ENV=production
BACKEND_INTERNAL_URL=http://127.0.0.1:4000
# Keep demo cards alongside live CMS news. Set false to show only CMS posts.
VGG_DEMO_NEWS=true
# Supplied PDF documents for the demo. Set false to restore CMS resources.
VGG_DEMO_RESOURCES=true
ALLOWED_ORIGINS=https://vgg.vlu.edu.vn

# Optional External CRM Webhook (If integrated with university CRM)
CONSULTATION_WEBHOOK_URL=
