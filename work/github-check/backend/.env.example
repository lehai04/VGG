# ==============================================================================
# Backend API Service Environment Configuration Template
# ==============================================================================
NODE_ENV=production
DATABASE_URL=postgresql://vgg:<GENERATE_STRONG_DATABASE_PASSWORD>@127.0.0.1:5433/vgg
REDIS_URL=redis://127.0.0.1:6379

BACKEND_HOST=0.0.0.0
BACKEND_PORT=4000
PUBLIC_APP_URL=https://vgg.vlu.edu.vn
ADMIN_APP_URL=https://admin-vgg.vlu.edu.vn

# Initial Super Admin Account Creation (Used on first bootstrap)
INITIAL_ADMIN_USERNAME=admin
INITIAL_ADMIN_PASSWORD=<INITIAL_SUPER_ADMIN_PASSWORD>
INITIAL_ADMIN_NAME=Super Admin
INITIAL_ADMIN_EMAIL=admin@vlu.edu.vn

# Required on-premise MinIO Storage Configuration
STORAGE_ENDPOINT=127.0.0.1
STORAGE_PORT=9000
STORAGE_USE_SSL=false
STORAGE_BUCKET=vgg-media
STORAGE_ACCESS_KEY=vgg_platform_app
STORAGE_SECRET_KEY=<GENERATE_SEPARATE_APP_PASSWORD>
