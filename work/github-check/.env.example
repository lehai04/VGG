# ==============================================================================
# VGG Platform - Root Docker Environment Configuration Template
# ==============================================================================
# NOTE: Copy this file to .env and replace placeholders with strong, secure credentials.
#
# cp .env.example .env

POSTGRES_DB=vgg
POSTGRES_USER=vgg
POSTGRES_PASSWORD=<GENERATE_STRONG_DATABASE_PASSWORD>
MINIO_ROOT_USER=vgg_storage_admin
MINIO_ROOT_PASSWORD=<GENERATE_STRONG_MINIO_PASSWORD>
MINIO_APP_ACCESS_KEY=vgg_platform_app
MINIO_APP_SECRET_KEY=<GENERATE_SEPARATE_APP_PASSWORD>
STORAGE_BUCKET=vgg-media
