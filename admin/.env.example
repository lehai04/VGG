# ==============================================================================
# Admin Portal Environment Configuration Template
# ==============================================================================
NODE_ENV=production
DATABASE_URL=postgresql://vgg:<GENERATE_STRONG_DATABASE_PASSWORD>@127.0.0.1:5433/vgg
BACKEND_INTERNAL_URL=http://127.0.0.1:4000
ADMIN_ALLOWED_ORIGINS=https://admin-vgg.vlu.edu.vn

# MinIO chạy nội bộ (REQUIRED cho CMS upload ảnh và tài liệu)
STORAGE_ENDPOINT=127.0.0.1
STORAGE_PORT=9000
STORAGE_USE_SSL=false
STORAGE_BUCKET=vgg-media
STORAGE_ACCESS_KEY=vgg_platform_app
STORAGE_SECRET_KEY=<GENERATE_SEPARATE_APP_PASSWORD>
STORAGE_MAX_RESOURCE_FILE_MB=25


# Initial Super Admin Bootstrap (Optional if bootstrapped via backend)
INITIAL_ADMIN_USERNAME=admin
INITIAL_ADMIN_PASSWORD=<INITIAL_SUPER_ADMIN_PASSWORD>
INITIAL_ADMIN_NAME=Super Admin
INITIAL_ADMIN_EMAIL=admin@vlu.edu.vn

# Optional SMTP Email Configuration (For Password Reset Emails)
SMTP_HOST=smtp.gmail.com
SMTP_PORT=587
SMTP_USER=no-reply@vlu.edu.vn
SMTP_PASS=<SMTP_APP_PASSWORD>
SMTP_FROM="VGG Admin Portal <no-reply@vlu.edu.vn>"

# ==============================================================================
# Single Sign-On (SSO) Configuration
# Dành cho đăng nhập tài khoản Trường (Microsoft 365 @vlu.edu.vn & @vanlanguni.edu.vn)
# ==============================================================================
# Microsoft Entra ID (Azure AD) OAuth 2.0
# Đăng ký App trên Microsoft Azure Portal (hoặc liên hệ Trung tâm CNTT Văn Lang)
# Redirect URI: https://admin-vgg.vlu.edu.vn/api/admin/auth/sso/microsoft/callback
SSO_MICROSOFT_CLIENT_ID=
SSO_MICROSOFT_CLIENT_SECRET=
SSO_MICROSOFT_TENANT_ID=common

# Google Workspace OAuth 2.0 (Tùy chọn)
# Redirect URI: https://admin-vgg.vlu.edu.vn/api/admin/auth/sso/google/callback
SSO_GOOGLE_CLIENT_ID=
SSO_GOOGLE_CLIENT_SECRET=
